# ==== ChainIntel backend configuration ====
# Copy to backend/.env and adjust. Never commit real keys.
# ChainIntel runs against real blockchain APIs only (no demo mode).

# Application mode: always LIVE
APP_MODE=LIVE

# Database: SQLite by default; PostgreSQL recommended for production
# DATABASE_URL=postgresql+psycopg2://chainintel:chainintel@localhost:5432/chainintel
DATABASE_URL=sqlite:///./data/chainintel.db

# Comma-separated CORS origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000

# Blockchain provider configuration
#
# Bitcoin: public APIs work without keys.
#   primary   : mempool.space (keyless)
#   fallback  : blockchain.info (keyless; optional api_code raises the rate limit)
MEMPOOL_API_URL=https://mempool.space/api
BITCOIN_API_URL=https://blockchain.info
BLOCKCHAIN_API_KEY=

# Ethereum + BNB Smart Chain: any ONE key below unlocks both chains.
# Providers are tried in order and fail over automatically:
#   1. Etherscan v2 (multichain, free): https://etherscan.io/apis
ETHERSCAN_API_KEY=
ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
#   2. Moralis (free tier): https://moralis.io/
MORALIS_API_KEY=
MORALIS_API_URL=https://deep-index.moralis.io/api/v2.2
#   3. Ankr (free tier): https://www.ankr.com/rpc/
ANKR_API_KEY=
ANKR_API_URL=https://rpc.ankr.com/multichain
# Separate BscScan key (optional - the Etherscan v2 key above covers BSC too).
BSCSCAN_API_KEY=

# OSINT
OSINT_PROVIDER_ENABLED=false

# Monitoring engine
POLL_INTERVAL_SECONDS=60
MONITORING_ENABLED=true

# Security / limits
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_MB=10
EVIDENCE_DIR=./data/evidence
